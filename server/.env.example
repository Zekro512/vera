# Copy this file to .env and fill in your own values.
# Never commit the real .env — it is gitignored.

PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=

# Razorpay Test Mode keys (Dashboard > Account & Settings > API Keys)
# The key ID is public and is sent to the browser.
# The key secret is used only server-side, for signature verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Gemini API key
GEMINI_API_KEY=
