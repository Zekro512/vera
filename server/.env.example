# Copy this file to .env and fill in your own values.
# Never commit the real .env — it is gitignored.

PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=

# Razorpay Test Mode keys (Dashboard > Account & Settings > API Keys)
# The key ID is public and is sent to the browser.
# The key secret is used only server-side, for signature verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Gemini API key
GEMINI_API_KEY=

# Bounds on what the agent may propose or transact. The agent cannot raise
# these; only the operator can. Defaults are 10 and 1000 if unset.
MAX_ITEM_QUANTITY=10
MAX_ORDER_VALUE=1000
